<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tenshi_no_hana">
  <!-- Provisional dimensions. Replace these properties with measured values. -->
  <xacro:property name="base_length" value="0.22"/>
  <xacro:property name="base_width" value="0.16"/>
  <xacro:property name="base_height" value="0.06"/>
  <xacro:property name="wheel_radius" value="0.033"/>
  <xacro:property name="wheel_width" value="0.026"/>
  <xacro:property name="wheel_separation" value="0.13"/>
  <xacro:property name="base_z" value="${wheel_radius + 0.015}"/>

  <material name="body_green"><color rgba="0.12 0.42 0.24 1"/></material>
  <material name="wheel_black"><color rgba="0.04 0.04 0.04 1"/></material>
  <material name="sensor_blue"><color rgba="0.08 0.35 0.72 1"/></material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_z}"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <material name="body_green"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_z}"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${base_z}"/>
      <mass value="0.8"/>
      <inertia ixx="0.00195" ixy="0" ixz="0" iyy="0.00347" iyz="0" izz="0.00427"/>
    </inertial>
  </link>

  <xacro:macro name="drive_wheel" params="name side">
    <link name="${name}">
      <visual>
        <origin rpy="${pi / 2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin rpy="${pi / 2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="0 ${side * wheel_separation / 2} ${wheel_radius}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel name="left_wheel_link" side="1"/>
  <xacro:drive_wheel name="right_wheel_link" side="-1"/>

  <link name="caster_link">
    <visual><geometry><sphere radius="0.012"/></geometry><material name="wheel_black"/></visual>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/><child link="caster_link"/>
    <origin xyz="-0.085 0 0.012"/>
  </joint>

  <link name="imu_link">
    <visual><geometry><box size="0.025 0.02 0.006"/></geometry><material name="sensor_blue"/></visual>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/>
    <origin xyz="0 0 ${base_z + base_height / 2 + 0.006}"/>
  </joint>

  <link name="ultrasonic_link">
    <visual><geometry><box size="0.012 0.045 0.02"/></geometry><material name="sensor_blue"/></visual>
  </link>
  <joint name="ultrasonic_joint" type="fixed">
    <parent link="base_link"/><child link="ultrasonic_link"/>
    <origin xyz="${base_length / 2 + 0.006} 0 ${base_z}"/>
  </joint>
</robot>
