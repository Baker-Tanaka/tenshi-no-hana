Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 238; 240; 236
    Fixed Frame: odom
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground Grid
      Enabled: true
      Cell Size: 0.25
      Plane: XY
      Color: 170; 174; 168
    - Class: rviz_default_plugins/RobotModel
      Name: Rover
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Show Axes: true
      Show Names: true
    - Class: rviz_default_plugins/Odometry
      Name: Open-loop odometry
      Enabled: true
      Topic:
        Value: /odom
        Reliability Policy: Reliable
      Shape:
        Value: Arrow
      Keep: 100
      Color: 33; 112; 76
    - Class: rviz_default_plugins/Range
      Name: Front ultrasonic
      Enabled: true
      Topic:
        Value: /ultrasonic/front
        Reliability Policy: Reliable
      Color: 225; 90; 35
      Buffer Length: 1
    - Class: rviz_default_plugins/Path
      Name: Global plan
      Enabled: true
      Topic:
        Value: /plan
        Reliability Policy: Reliable
      Line Style: Lines
      Line Width: 0.03
      Color: 42; 92; 180
    - Class: rviz_default_plugins/Path
      Name: Local plan
      Enabled: true
      Topic:
        Value: /local_plan
        Reliability Policy: Reliable
      Line Style: Lines
      Line Width: 0.03
      Color: 220; 90; 30
    - Class: rviz_default_plugins/Map
      Name: Global costmap
      Enabled: true
      Topic:
        Value: /global_costmap/costmap
        Durability Policy: Transient Local
      Alpha: 0.45
    - Class: rviz_default_plugins/Map
      Name: Local costmap
      Enabled: true
      Topic:
        Value: /local_costmap/costmap
        Durability Policy: Transient Local
      Alpha: 0.65
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top Down
      Scale: 80
Window Geometry:
  Width: 1280
  Height: 800
