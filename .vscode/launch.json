        }
    ],
    "inputs": [
        {
            "id": "sensorExample",
            "description": "Sensor example name",
            "type": "pickString",
            "options": [
                "sensor_read",
                "esp_hosted_spi_test"
            ],
            "default": "sensor_read"
        },
        {
            "id": "wifiExample",
            "description": "WiFi-only example name",
            "type": "pickString",
            "options": [
                "microros_hello",
                "microros_subscriber",
                "microros_service_client",
                "microros_service_server",
                "microros_action_client",
                "microros_action_server",
                "microros_resilient"
            ],
            "default": "microros_hello"
        },
        {
            "id": "wifiSensorExample",
            "description": "WiFi + sensor example name",
            "type": "pickString",
            "options": [
                "wifi_microros_rover",
                "wifi_microros_sensors"
            ],
            "default": "wifi_microros_rover"
        }
    ]
