# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# Python bytecode and test caches
__pycache__/
*.py[cod]

# VS Code C/C++ extension database
.vscode/browse.vc.db*

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# WiFi credentials (contains SSID/password — never commit)
wifi_config.json

# Per-installation Baker Link Env connection token.
.bakerlink/connection.json

cad/tenshi_no_hana/tenshi_no_hana-backups/

cad/tenshi_no_hana/~*
cad/tenshi_no_hana/.history

# ROS 2 colcon outputs
/build/
/install/
/log/
/ros2_ws/build/
/ros2_ws/install/
/ros2_ws/log/
.vscode/browse.vc.2*
